{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-visitor-counter",
  "main": "src/index.js",
  "compatibility_date": "2026-08-30",
  "durable_objects": {
    "bindings": [
      {
        "name": "VISITOR_COUNTER",
        "class_name": "VisitorCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VisitorCounter"]
    }
  ]
}
